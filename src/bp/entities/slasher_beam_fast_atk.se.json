{
  "format_version": "1.21.50",
  "minecraft:entity": {
    "description": {
      "identifier": "lc:slasher_beam_fast_atk",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false,
      "runtime_identifier": "minecraft:snowball",
      // Intentionally left disabled, unlike slasher_beam_charged_atk.se.json
      // (which plays "slasher.beam.woosh" via this same animation): the
      // fast attack fires 3 of these simultaneously, and looping the same
      // sound 3x at once read as noisy/spammy in testing rather than
      // impactful. Uncomment both this block and the matching entry in
      // "properties" is NOT needed — properties are unaffected — just
      // uncomment "scripts"/"animations" below to re-enable per-bit woosh.
      // "scripts": {
      //   "animate": ["anim.woosh_loop"]
      // },
      // "animations": {
      //   "anim.woosh_loop": "animation.bp.slasher_beam.woosh_loop"
      // },
      "properties": {
        "lc:is_visible": {
          "type": "bool",
          "default": false,
          "client_sync": true
        },
        "lc:bit": {
          "type": "int",
          "range": [
            // 0: Left
            // 1: Center
            // 2: Right
            0, 2
          ],
          "default": 0,
          "client_sync": true
        },
        "lc:rotation_x": {
          "type": "float",
          "range": [-180.0, 180.0],
          "default": 0.0,
          "client_sync": true
        },
        "lc:rotation_y": {
          "type": "float",
          "range": [-180.0, 180.0],
          "default": 0.0,
          "client_sync": true
        },
        "lc:rotation_z": {
          "type": "float",
          "range": [-180.0, 180.0],
          "default": 0.0,
          "client_sync": true
        }
      }
    },
    "component_groups": {},
    "components": {
      "minecraft:type_family": {
        "family": ["projectile", "slasher_beam"]
      },
      "minecraft:projectile": {
        "on_hit": {
          "stick_in_ground": {
            "shake_time": 0.1
          }
        },
        "power": 1.0,
        "gravity": 0.0,
        "inertia": 1.0,
        "liquid_inertia": 1.0,
        "uncertainty_base": 1.0,
        "uncertainty_multiplier": 1.0,
        "anchor": 1,
        "offset": [0, -0.1, 0],
        "reflect_on_hurt": false,
        "catch_fire": false
      },
      "minecraft:timer": {
        "looping": false,
        "randomInterval": false,
        "time": 0.35,
        "time_down_event": {
          "event": "timeout",
          "target": "self"
        }
      },
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      },
      "minecraft:collision_box": {
        "width": 0.45,
        "height": 0.45
      },
      "minecraft:physics": {},
      "minecraft:body_rotation_blocked": {},
      "minecraft:fire_immune": {},
      "minecraft:dimension_bound": {},
      "minecraft:transient": {}
    },
    "events": {
      "timeout": {}
    }
  }
}
