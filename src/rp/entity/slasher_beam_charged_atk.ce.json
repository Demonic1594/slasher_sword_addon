{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "lc:slasher_beam_charged_atk",
      "materials": {
        "default": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/slasher/beam_charged_atk"
      },
      "geometry": {
        "default": "geometry.slasher_beam_charged_atk"
      },
      "animations": {
        // Animations
        "anim.base_rotation": "animation.slasher_beam_charged_atk.base_rotation",
        "anim.spin": "animation.slasher_beam_charged_atk.spin",
        "anim.trail": "animation.slasher_beam_charged_atk.trail"
      },
      "scripts": {
        // Matches the source model's own approach: scaled to nothing until
        // lc:is_visible flips true (beam.js sets this ~2 ticks after spawn,
        // once its travel velocity is confirmed), rather than only gating
        // the trail particles like the old xy/z beam did. Keeps the beam
        // from flashing into view at its spawn point for those first ticks.
        "scale": "v.is_visible ? 1.15 : 0",
        "animate": [
          "anim.base_rotation",
          {
            "anim.spin": "v.is_visible"
          },
          {
            "anim.trail": "v.is_visible"
          }
        ],
        "initialize": [
          "v.is_visible = false;",
          "v.rotation_x = 0;",
          "v.rotation_y = 0;",
          "v.rotation_z = 0;"
        ],
        "pre_animation": [
          "v.is_visible = q.property('lc:is_visible');",
          "v.rotation_x = q.property('lc:rotation_x');",
          "v.rotation_y = q.property('lc:rotation_y');",
          "v.rotation_z = q.property('lc:rotation_z');"
        ],
        "should_update_effects_offscreen": "1.0"
      },
      "particle_effects": {
        "trail": "lc:slasher_beam_trail_emitter"
      },
      "render_controllers": ["controller.render.slasher_beam"]
    }
  }
}
